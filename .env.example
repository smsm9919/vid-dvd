# VideoFactory Local — example configuration.
# Copy this file to ".env" and fill in real values.
# NEVER commit a real .env. Secrets must only ever come from environment variables.

# ---- App server ----
APP_HOST=127.0.0.1
APP_PORT=8090

# ---- ComfyUI (local video generation provider) ----
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/wan22_ti2v_api.json
# Optional: override the auto-detected positive-prompt node.
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_FIELD=text
# Per-job generation timeout in seconds (default 1800 = 30 min).
COMFYUI_TIMEOUT_SECONDS=1800

# ---- AI scene planning (optional) ----
# Leave empty to use the built-in deterministic local planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Provider selection ----
# Comma-separated preferred video providers, evaluated in order.
# First provider that reports healthy wins. Empty = auto-detect.
# Supported: comfyui, wan
VIDEO_PROVIDERS=comfyui

# ---- Wan 2.2 (Phase 8) ----
# API-format Wan workflows exported from ComfyUI (see workflows/README.md).
WAN_T2V_WORKFLOW=workflows/wan22_t2v_api.json
WAN_I2V_WORKFLOW=workflows/wan22_i2v_api.json
# Substring used to detect the Wan model in ComfyUI /object_info.
WAN_REQUIRED_MODEL=wan2.2

# ---- Phase 13: free-first multi-provider hub ----
# When true (default), paid providers are never selected automatically.
FREE_FIRST=true
# Paid providers may only run when ALLOW_PAID_PROVIDERS=true AND the per-call
# cost is within MAX_PAID_COST_USD. Leave false for a free-only pipeline.
ALLOW_PAID_PROVIDERS=false
MAX_PAID_COST_USD=0

# ---- Stock video/photo providers (free tiers) ----
# Pexels: free API, Pexels License (commercial use allowed, no attribution req).
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: free API, Pixabay Content License (commercial use allowed).
# Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Per-provider HTTP timeout (seconds) and max download size (bytes, default 200MB).
STOCK_HTTP_TIMEOUT=30
STOCK_MAX_DOWNLOAD_BYTES=209715200

# ---- Piper TTS (local, CPU, GPL-3.0 — OPT-IN) ----
# piper-tts is GPL-3.0 (OHF-Voice/piper1-gpl). Enable only if your project can
# comply with GPL-3.0. Install with:  pip install piper-tts
# Voices are downloaded on demand to PIPER_VOICES_DIR (never bundled in repo).
PIPER_ENABLED=false
PIPER_VOICES_DIR=models/piper_voices
PIPER_DEFAULT_VOICE_EN=en_US-lessac-medium
PIPER_DEFAULT_VOICE_DE=de_DE-thorsten-medium
# Arabic: leave empty (no default Piper voice). Set a voice name to enable ar.
PIPER_DEFAULT_VOICE_AR=
